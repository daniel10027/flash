# ── Flash — variables d'environnement (exemple) ───────────────────────────────
# Copier en `.env` pour le développement local. Ne jamais committer de vraies valeurs.

# --- Général -------------------------------------------------------------------
FLASH_ENV=development                 # development | staging | production
FLASH_SECRET_KEY=change-me-in-.env-32-chars-min
FLASH_LOG_LEVEL=INFO

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de données (PostgreSQL) -------------------------------------------
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash
POSTGRES_DB=flash
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://flash:flash@db:5432/flash

# --- Redis (idempotence, OTP, rate-limit, verrous, pub/sub SSE) ------------
REDIS_URL=redis://redis:6379/0

# --- JWT ------------------------------------------------------------------------
JWT_ACCESS_TTL_SECONDS=900            # 15 min
JWT_REFRESH_TTL_SECONDS=2592000       # 30 jours

# --- OTP ----------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_CHANNEL=console                   # console (dev) | http_sms (prod)

# --- Notifications (gratuit) -------------------------------------------------
# Email (SMTP) — en dev, Mailhog écoute sur mailhog:1025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Flash <no-reply@flash.local>
# Push (Firebase Cloud Messaging)
FCM_CREDENTIALS_JSON=                 # chemin ou contenu JSON du compte de service ; vide = push désactivé

# --- KYC (vérification d'identité) ------------------------------------------
# Racine de stockage des pièces justificatives KYC.
KYC_DOCUMENT_DIR=/var/lib/flash/kyc
# Clé partagée du back-office (en-tête X-Admin-Key). Laisser vide désactive les
# routes /v1/admin/* (fail closed).
ADMIN_API_KEY=

# --- Annulation / remboursement --------------------------------------------
# Délai (secondes) pour annuler un transfert / rembourser un paiement marchand.
REVERSAL_WINDOW_SECONDS=3600

# --- Pays par défaut ---------------------------------------------------------
DEFAULT_COUNTRY=CI
DEFAULT_CURRENCY=XOF
# Référentiel pays / opérateurs : "static" (jeu intégré) ou "db" (tables + cache Redis).
REFERENCE_SOURCE=static

# --- Passerelles externes (sandbox par défaut) ----------------------------------
OPERATOR_GATEWAY=sandbox              # sandbox | <connecteur réel>
CARD_ISSUER=sandbox
BANK_GATEWAY=sandbox

# --- Carte -------------------------------------------------------------------
# Secret HMAC partagé avec le réseau carte pour signer le webhook d'autorisation.
CARD_WEBHOOK_SECRET=
CARD_DAILY_LIMIT_MINOR=500000
CARD_MONTHLY_LIMIT_MINOR=5000000
