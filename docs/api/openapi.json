{
  "openapi": "3.1.0",
  "info": {
    "title": "Flash API",
    "version": "0.1.0",
    "description": "API de la plateforme de monnaie électronique Flash."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "GET /health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "GET /health/ready",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Créer un compte (en attente d'activation par OTP)",
        "tags": [
          "auth"
        ],
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string"
                    },
                    "wallet_id": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "phone_number_masked": {
                      "type": "string"
                    },
                    "activation_required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "Erreur métier ou de validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "phone_number": {
                    "examples": [
                      "+2250700000000"
                    ],
                    "maxLength": 24,
                    "minLength": 6,
                    "title": "Phone Number",
                    "type": "string"
                  },
                  "pin": {
                    "examples": [
                      "1397"
                    ],
                    "maxLength": 6,
                    "minLength": 4,
                    "title": "Pin",
                    "type": "string"
                  },
                  "country": {
                    "examples": [
                      "CI"
                    ],
                    "maxLength": 2,
                    "minLength": 2,
                    "title": "Country",
                    "type": "string"
                  }
                },
                "required": [
                  "phone_number",
                  "pin",
                  "country"
                ],
                "title": "RegisterRequest",
                "type": "object"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255
            }
          }
        ]
      }
    },
    "/v1/auth/verify-otp": {
      "post": {
        "summary": "Activer un compte avec le code reçu par SMS",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "access_expires_in": {
                      "type": "integer"
                    },
                    "refresh_expires_in": {
                      "type": "integer"
                    },
                    "user_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "Erreur métier ou de validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "phone_number": {
                    "examples": [
                      "+2250700000000"
                    ],
                    "maxLength": 24,
                    "minLength": 6,
                    "title": "Phone Number",
                    "type": "string"
                  },
                  "country": {
                    "examples": [
                      "CI"
                    ],
                    "maxLength": 2,
                    "minLength": 2,
                    "title": "Country",
                    "type": "string"
                  },
                  "code": {
                    "examples": [
                      "000000"
                    ],
                    "maxLength": 8,
                    "minLength": 4,
                    "title": "Code",
                    "type": "string"
                  },
                  "device_id": {
                    "examples": [
                      "a1b2c3d4"
                    ],
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Device Id",
                    "type": "string"
                  }
                },
                "required": [
                  "phone_number",
                  "country",
                  "code",
                  "device_id"
                ],
                "title": "VerifyOtpRequest",
                "type": "object"
              }
            }
          }
        }
      }
    },
