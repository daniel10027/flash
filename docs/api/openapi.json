                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Ajouter un numéro (envoie un code de vérification)",
        "tags": [
          "phones"
        ],
        "responses": {
          "202": {
            "description": "Succès"
          },
          "4XX": {
            "description": "Erreur métier ou de validation",
            "content": {
              "application/json": {
                "schema": {
