        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "phone_number": {
                    "examples": [
                      "+2250700000000"
                    ],
                    "maxLength": 24,
                    "minLength": 6,
                    "title": "Phone Number",
                    "type": "string"
                  },
                  "country": {
                    "anyOf": [
                      {
                        "maxLength": 2,
                        "minLength": 2,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Country"
                  }
                },
                "required": [
                  "phone_number"
                ],
                "title": "PhoneRef",
                "type": "object"
              }
            }
          }
        }
      },
