{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Flash",
    "description": "Jetons de design Flash — thème bordeaux. Source de vérité partagée web + mobile.",
    "version": "0.1.0"
  },
  "color": {
    "brand": {
      "50": "#fbeef0",
      "100": "#f4ccd2",
      "200": "#e79aa6",
      "300": "#d76678",
      "400": "#c23d54",
      "500": "#8c1d33",
      "600": "#7a1a2d",
      "700": "#621525",
      "800": "#4b101c",
      "900": "#360b14"
    },
    "accent": {
      "300": "#7cd4c0",
      "500": "#12a594",
      "700": "#0c7a6d"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#f7f7f8",
      "100": "#ededf0",
      "200": "#dcdce1",
      "300": "#c2c2cb",
      "400": "#9a9aa6",
      "500": "#727282",
      "600": "#54545f",
      "700": "#3c3c45",
      "800": "#26262c",
      "900": "#161619"
    },
    "success": { "fg": "#0c7a3f", "bg": "#e6f4ea" },
    "warning": { "fg": "#8a5a00", "bg": "#fbf0dc" },
    "danger": { "fg": "#a4152b", "bg": "#fbe9ec" },
    "info": { "fg": "#0b5c9c", "bg": "#e7f1fb" }
  },
  "font": {
    "family": {
      "sans": "'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'SFMono-Regular', ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.25rem"
    },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "lineHeight": { "tight": "1.2", "normal": "1.5", "relaxed": "1.7" }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "8": "3rem",
    "10": "4rem"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(22, 22, 25, 0.08)",
    "md": "0 4px 12px rgba(22, 22, 25, 0.10)",
    "lg": "0 12px 32px rgba(22, 22, 25, 0.16)"
  },
  "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
  "z": { "nav": "100", "sheet": "200", "toast": "300", "modal": "400" }
}
