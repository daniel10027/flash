# INFRA-014/019 — variables de production. Copier vers /etc/flash/flash.env sur le
# VPS (chmod 600, propriétaire root). NE JAMAIS committer la version remplie.

# --- Déploiement -------------------------------------------------------------
COMPOSE_PROJECT_NAME=flash
IMAGE_OWNER=daniel10027            # espace GHCR (github.repository_owner)
IMAGE_TAG=latest                  # fixé par le pipeline (vX en prod, sha-… en staging)
FLASH_ENV_FILE=/etc/flash/flash.env

# --- Domaines & TLS --------------------------------------------------------
DOMAIN=flash.example              # app.<DOMAIN> / api.<DOMAIN>
ACME_EMAIL=ops@flash.example

# --- API ------------------------------------------------------------------
FLASH_ENV=production
FLASH_SECRET_KEY=CHANGE-MOI-32-caracteres-minimum-aleatoires
API_WORKERS=3
API_REPLICAS=2
CORS_ALLOWED_ORIGINS=https://app.flash.example
API_BASE_URL=https://api.flash.example
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- PostgreSQL (interne, jamais exposé) ---------------------------------
POSTGRES_USER=flash
POSTGRES_PASSWORD=CHANGE-MOI-mot-de-passe-fort
POSTGRES_DB=flash

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Notifications ----------------------------------------------------------
SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Flash <no-reply@flash.example>
FCM_CREDENTIALS_JSON=/etc/flash/fcm.json

# --- Back-office (RBAC par clé) ------------------------------------------
ADMIN_API_KEY=CHANGE-MOI-cle-admin
ADMIN_API_KEYS=compliance:CHANGE-MOI,finance:CHANGE-MOI

# --- Passerelles externes (sandbox tant que non contractées) ------------------
OPERATOR_GATEWAY=sandbox
OPERATOR_WEBHOOK_SECRET=
CARD_ISSUER=sandbox
CARD_WEBHOOK_SECRET=
BANK_GATEWAY=sandbox

# --- KYC -----------------------------------------------------------------
KYC_DOCUMENT_DIR=/var/lib/flash/kyc

# --- Sauvegardes ---------------------------------------------------------
BACKUP_CRON=17 2 * * *
BACKUP_GPG_RECIPIENT=ops@flash.example      # id de la clé PUBLIQUE GPG
OFFSITE_REMOTE=                             # ex. s3:flash-backups (rclone), vide = local seulement
RCLONE_CONFIG=/etc/flash/rclone.conf

# --- Observabilité (optionnel) ----------------------------------------------
FLASH_SENTRY_DSN=
